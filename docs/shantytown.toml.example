# shantytown.toml — copy to <root>/shantytown.toml (usually .shanty/shantytown.toml)
#
# Everything in this file is OPTIONAL. With no file at all you get the built-in
# defaults, which are deliberately the cheap ones:
#
#     mode = "lite"        the administrator alone, and nobody else
#     hibernate off        no agent is ever put to sleep that you did not ask to be
#
# The surprising direction of each knob is the one that costs money or loses work,
# so the default is the other one.
#
# THE FILENAME IS `shantytown.toml`, NOT `shanty.toml`. `shanty` is a different
# program (a tmux wrapper) that lives on the same PATH and in the same workspaces —
# the same reason this project's binary is `st`. A config file two tools each
# believe they own is a config file that gets edited for the wrong reader.
#
# AN UNKNOWN KEY IS REFUSED, not ignored. `st start` will not launch anything until
# the file parses, and it names the file and the key. A silently-dropped key is how
# an operator comes to believe a policy is in force when it is not.

# ---------------------------------------------------------------------------
# [startup] — which mode `st start` uses when you do not pass --mode.
# ---------------------------------------------------------------------------
[startup]
mode = "lite"

# ---------------------------------------------------------------------------
# [modes.<name>] — a mode is a NAMED SET OF CREW. This is the token-conservation
# dial: "how much fleet tonight" is a decision you make once and re-use, so it
# gets a name rather than a --count.
#
# `crew` entries are selectors, resolved against the cards that exist:
#
#     "*"                every non-retired card
#     "administrator"    | "lead" | "worker"   — every card with that role
#     "sattler"          — that agent by name
#
# A RETIRED card is NEVER selected, not even by "*" and not even by naming it
# explicitly. Retirement is a deliberate, durable shutdown; `st tend --unretire`
# is what undoes it. `st start` reports every retiree it skipped, so a skipped
# line never looks like a config line that was ignored.
#
# Your modes MERGE OVER the built-ins: defining `night` below does not remove
# `lite` or `heavy`. You MAY redefine either one — that is a deliberate override,
# which is what a config file is for.
#
# Built in, and equivalent to:
#     [modes.lite]
#     crew = ["administrator"]
#     [modes.heavy]
#     crew = ["*"]
# ---------------------------------------------------------------------------

# A middle gear: the coordinator and its leads, but no workers until the admin
# decides who is actually needed.
[modes.night]
crew = ["administrator", "lead"]

# A named subset for one project's crew.
# [modes.aegis]
# crew = ["sattler", "arnold", "billy"]

# ---------------------------------------------------------------------------
# [hibernate] — may the ADMINISTRATOR's stop decline to wake it?
#
# WHAT THIS ACTUALLY GATES: nothing is suspended and no process sleeps. Claude
# Code's Stop hook fires at the end of every turn, and an administrator's hook
# DRAINS — it re-injects whatever arrived, which is what keeps a coordinator
# awake, and billing, all night. Hibernating means that block is skipped while
# the fleet has nothing for the coordinator to decide, so its turn actually ends.
#
# IT CAN ONLY EVER FIRE WHEN QUIET IS CORRECT. The stop decision is one ordered
# list (docs/stop-policy-spec.md), and hibernate is rank 3 of five:
#
#   1  an urgent event (untracked-work alert, or one that rose past a dead lead)
#   2  RULE ZERO: free feedable workers AND dispatchable work  -> keep working
#   3  hibernate                                               -> go quiet
#   4  an ordinary pending report                              -> deliver it
#
# So Rule Zero OVERRIDES hibernate, and says so by name when it does. You cannot
# accidentally sleep a coordinator that has work to hand out.
#
# NOTHING IS LOST. Rank 3 allows the stop without consuming anything, so a
# sleeping admin's backlog is intact and the next wake sees all of it. Count it
# without consuming it: `st anchor --events <admin>`.
#
# IT REMOVES A SELF-WAKE, NEVER A WAKE. `st tend` pushes, an `st inbox`, a
# dispatch, or you typing in the pane all still reach it.
#
#   enabled            false = the stop wakes it at every turn, as it always has.
#   max_quiet_minutes  NOT a schedule to wake ON — a BOUND on how long waiting
#                      reports may sit unread while nothing pushes. 0 disables
#                      the bound, which is legitimate: a push is a wake with a
#                      REASON, which beats a timer.
#
# Leads and workers never hibernate: a lead's drain is how it absorbs its reports.
# ---------------------------------------------------------------------------
[hibernate]
enabled = false
max_quiet_minutes = 60

# ---------------------------------------------------------------------------
# [fleet] — state Rule Zero must respect.
#
# Rule Zero blocks a coordinator's stop while free feedable workers AND
# dispatchable work both exist, so it cannot go idle with the fleet idle. It could
# only ever demand MORE dispatch, which meant two states it got wrong:
#
#   stood_down         A DELIBERATE quiet period was indistinguishable from
#                      neglect. Measured: an operator out of usage credits stopped
#                      nine of eleven crew on instruction, and the gate blocked
#                      every stop demanding they be re-dispatched. Set this and
#                      Rule Zero yields — out loud, naming the reason, because a
#                      gate that goes silent reads as a gate that is broken.
#                      It is config, not a runtime flag, for the same reason
#                      retirement lives on a card: a deliberate shutdown must
#                      survive the session that decided it.
#                      It also quiets the administrator's PRIORITIZE list, which
#                      read every down pane as a defect and listed all nine of
#                      those agents as "re-dispatch — STOPPED". Risen escalations
#                      still surface: standing the fleet down declines to hand out
#                      work, it does not decline to ANSWER. What was withheld is
#                      reported on the same line, never silently dropped.
#                      A RETIRED card (`st tend --retire`) is excluded from that
#                      list unconditionally, stood down or not — down is the intent.
#
#   max_load_per_core  The gate compared nothing against the host: it forced
#                      dispatch to 9 agents on an 8-core box at load 33. Per-core
#                      so it travels between hosts. 0 disables the check. A load
#                      we cannot measure never suppresses the gate — refusing to
#                      dispatch on an unmeasured number would be the mirror of the
#                      bug.
# ---------------------------------------------------------------------------
[fleet]
stood_down = false
max_load_per_core = 4.0

# ---------------------------------------------------------------------------
# [env] — this deployment's PLUMBING: where the tracker is, which backend, the
# address of a graph server, a guard script path. Values that are also settable as
# environment variables, because that is what a launcher can carry into a pane.
#
# This used to be a separate `env.json`. It was folded in here because config lived
# in SEVEN places — env.json, this file, settings/<role>.settings.json,
# crew/<name>.json, settings/tmux-socket, hierarchy.*, and the ~/.config pointer —
# and there was no single answer to "where do I configure this?". Now exactly ONE
# of those is written by a human: this file. The others are generated (crew/,
# settings/), an import source (hierarchy.*), or a locator that by definition
# cannot live inside the deployment it points at (the pointer).
#
# PRECEDENCE: this table, then the ambient environment. The former env.json
# compatibility reader was removed after its deprecation window.
#
# THE FILE STILL BEATS THE ENVIRONMENT. Where a value is authored moved; which
# source wins did not — otherwise a stray shell export would silently override a
# value a deployment had pinned on purpose.
#
# THIS IS THE ONE TABLE WHOSE KEYS ARE NOT VALIDATED. The set is open by
# construction, so an unrecognised key here is your key, not a typo we can detect.
# Values must be single strings (numbers and booleans are accepted and stringified);
# a table or a list is refused, because the consumer is `os.environ`-shaped.
# ---------------------------------------------------------------------------
[env]
# SHANTY_BACKEND = "beads"              # files | beads | forgejo
# SHANTY_BEADS_REPO = "/path/to/repo"   # where the plates live
# SHANTY_ONTO_NS = "https://example.invalid/ontology#"
# SHANTY_REMOTE_CONTROL = "true"         # Claude harness only; exposes local sessions through Anthropic's relay

# ---------------------------------------------------------------------------
# [tmux] socket — the fleet's tmux socket, DECLARED. The former
# `settings/tmux-socket` compatibility reader was removed after deprecation.
#
# Declared and never inferred from the ambient $TMUX: an env var is what an
# operator's shell happens to hold, and a fleet whose panes are visible or not
# depending on which pane you ran `st` from is the bug that made every agent report
# DOWN. `st doctor` cross-checks it — if your registry's panes are alive on some
# OTHER socket, it says so rather than reporting a dead fleet.
#
# Omit it for the default tmux server.
# ---------------------------------------------------------------------------
[tmux]
# socket = "shanty"

# ---------------------------------------------------------------------------
# [harness] — WHICH AGENT PROGRAM, for cards that do not say.
#
# Claude Code is ONE harness, not the shape of the world. Two ship — `claude` and
# `codex` — and a card names its own with `harness = "..."`. This table is for the
# cards that DON'T: setting it per card is right for one exception and wrong for a
# fleet, where the same string ends up in twenty files and drifts in nineteen.
#
# MOST SPECIFIC WINS: the card, then this role rule, then this default, then
# `claude`. The same precedence shape [precedence.<axis>] uses below, because it is
# the same question — who decided this, and how narrowly? A card that names its
# program is never moved by a config written afterwards.
#
# BOTH HALVES ARE VALIDATED AT LOAD, and each catches a different silent failure. An
# unimplemented harness NAME is refused, because a typo in `default` moves every card
# in the fleet and would otherwise surface as `st new` failing agent by agent — a
# fleet-wide config error reported as a per-agent launch failure. A ROLE nobody has
# is refused for the reason every table here refuses unknown keys: a rule that
# applies to nobody reads as applied.
#
# WHY NOT `[roles.<name>] harness = ...`, which is where you looked first: that table
# is the trait vocabulary and its axis names are validated against the ontology, so a
# key there is a typo rather than an extension. Launch config is not a trait — it
# does not compose, does not stack, and has nothing to rank.
#
# A codex card can hold ANY role, including lead and administrator: codex delivers
# blocking stop hooks, which is the capability the tier gates on (docs/adapters.md
# carries the evidence and the version caveat). Two things it does not get yet, both
# named there: `st new`'s liveness verify reads Claude Code's pane markers, so a
# codex launch reports could-not-tell rather than live; and the matcher-scoped
# guards are not emitted for it.
# ---------------------------------------------------------------------------

# [harness]
# default = "codex"

# [harness.by_role]
# lead = "claude"
# administrator = "claude"

# ---------------------------------------------------------------------------
# [roles.<name>] — YOUR role vocabulary, as traits.
#
# st ships three roles because its built-in PROCESS is defined for three: depth-2,
# a-lead-absorbs, and a stop event rising past an unreachable lead. It does not ship
# a list of roles that may EXIST. That distinction used to be missing, and it was not
# a vocabulary problem — `role` WAS tree position, so the reports-to rules applied to
# every role and anything outside the tree was inexpressible. An advisor (consulted
# on demand, reporting to nobody, with nobody reporting to it) failed validation for
# having no lead.
#
# SIX AXES. Which are single- vs multi-valued is the whole reason an enum could not
# express this: a worker is dispatched AND self-directed; a lead absorbs AND
# dispatches.
#
#   attachment    single   rooted | reports-to | unattached
#   workIntake    MULTI    dispatched | self-directed | consulted | escalations-only | none
#   coordination  MULTI    absorbs | dispatches | neither
#   scope         single   fleet-wide | domain-scoped | single-task
#   lifecycle     single   persistent | ephemeral
#   authority     single   veto-in-scope | gate | none
#
# `work_intake` and `workIntake` are both accepted (snake_case is what an operator
# writes; camelCase is what the ontology calls it). An unknown AXIS is refused — a
# dropped `attachement` would leave an advisor silently inside the reporting tree.
#
# ATTACHMENT = "unattached" IS THE UNLOCK. Such a role needs no reports_to, is given
# none, is exempt from the depth-2 rules, cannot take reports (that refuses rather
# than silently dropping the routing), and `st roles --check` reports it as `ok —
# unattached by role` instead of ORPHAN.
#
# A role may also be declared in the GRAPH (`CrewRole` + `hasRole`; see the
# SHANTY_ONTO_* table in the README). Same model, and roles STACK on one agent.
# ---------------------------------------------------------------------------

# [roles.advisor]
# attachment = "unattached"
# work_intake = ["consulted"]
# authority = "none"

# [roles.keeper]
# attachment = "reports-to"
# work_intake = ["consulted", "self-directed"]
# scope = "domain-scoped"
# authority = "veto-in-scope"

# ---------------------------------------------------------------------------
# [precedence.<axis>] — which value wins when STACKED roles conflict.
#
# An agent may hold several roles at once, and on a single-valued axis they can
# disagree: {worker, keeper} is scope {single-task, domain-scoped} and authority
# {none, veto-in-scope} simultaneously. The design prose says "most-specific wins" —
# but prose is not data, so st does NOT pick. Without a rank, composing that stack is
# an error naming the axis and the values. A tie-break written into st would be the
# closed enum reappearing one layer up, and an invisible one.
#
# Per axis VALUE, not per role: a role that is specific on one axis and generic on
# another is misranked by a single per-role number. Higher wins.
# ---------------------------------------------------------------------------

# [precedence.attachment]
# rooted = 3
# "reports-to" = 2
# unattached = 1

# [precedence.scope]
# "fleet-wide" = 3
# "domain-scoped" = 2
# "single-task" = 1

# [precedence.authority]
# "veto-in-scope" = 3
# gate = 2
# none = 1

# ---------------------------------------------------------------------------
# [governor] — SPIN THE CREW DOWN AS CLAUDE USAGE CLIMBS.
#
# Stiwi: "i want to be able to spin down the crew at certain configured
# intervals. like 50% spin down and only work p1+ issues. 70% p0 issues, 80%
# only support crew and then 95% stop and have all crew ensure work is pushed"
#
# THE THRESHOLDS AND THE ACTIONS ARE YOURS, not st's. Every number below is a
# tier in this file; nothing is hardcoded. Wanting 40/60/85 is a config edit.
#
# DECLARING A TIER IS WHAT TURNS IT ON. There is no `enabled` key, deliberately:
# a separate boolean creates exactly one new failure mode — you write four tiers,
# nothing happens, and you have to discover a fifth line was required. No tiers =
# off, which is the default.
#
#   source            prometheus | textfile | stub
#                     `textfile` reads the node_exporter file DIRECTLY and is
#                     usually the better choice on a host that runs both the
#                     probe and the crew: no scrape interval of lag, and no
#                     second service that can be down. `prometheus` is right
#                     when the crew is not on the probe's host. `stub` is for
#                     tests and for rehearsing a tier without being at 95%.
#   window            five_hour | seven_day — which window governs. NOTE the
#                     label spellings; they are the producer's, not `5h`/`7d`.
#   url               prometheus only. e.g. "http://prometheus.example"
#   username          basic auth, if your Prometheus requires it.
#   password_file     a PATH, never the password. This file is tracked, diffable
#                     and hand-edited, and it is the table you are most likely to
#                     paste into a ticket when asking why the governor is blind.
#   path              textfile only: the .prom file to read.
#   relax_margin      HYSTERESIS. A tier is left only below (at - margin), so a
#                     reading oscillating around 70 does not flip the fleet's
#                     dispatch policy every pass — each flip is a decision an
#                     agent already acted on. It can only ever hold a tier
#                     HIGHER than the live reading, never lower.
#   max_age_seconds   older than this and the reading is SIGNAL LOST, not a
#                     number. A governor reading a FROZEN value is worse than no
#                     governor: it holds the fleet wide open at a stale 12%
#                     forever and reads green the whole time.
#   on_signal_lost    warn (default) | freeze
#                     warn    the fleet runs UNGOVERNED and this ALARMS every
#                             pass. An idled fleet caused by a broken probe is
#                             its own outage, so the default errs toward running
#                             — but never quietly.
#                     freeze  dispatch nothing new. For a deployment that would
#                             rather stall than overspend.
#                     NEITHER ONE DRAINS. A probe bug must never be able to stop
#                     the crew, so the governor never fails INTO a shutdown.
#
# WHAT EACH TIER MAY RESTRICT (a tier that restricts nothing is refused — it
# would read as a policy in force while the fleet spends exactly as before):
#
#   min_priority   a dispatch floor in your tracker's numbering, where 0 is the
#                  HIGHEST. `min_priority = 1` admits P0 and P1 and refuses P2+.
#                  READ THE SIGN. An item carrying NO priority is refused while a
#                  floor is in force — above 50% the point is to spend only on
#                  work whose importance is stated.
#   traits         only agents whose ROLE SET carries one of these RUN at all.
#                  See [roles.*] below: `support` is a survival BAND, and the
#                  match is a THRESHOLD — "support and above", so an agent banded
#                  `last` also survives a support tier.
#   action         "drain" — the full stop. Every live agent is asked, DURABLY,
#                  to commit WIP on its own branch, push, report the SHAs, and
#                  stop itself. st never kills a pane; tend would just respawn it
#                  within five minutes. The report names who drained, what went
#                  up, and who failed — and UNREPORTED IS NOT DRAINED.
# ---------------------------------------------------------------------------

# [governor]
# delegation_reserve_pct = 10  # final band admits cross-harness delegation only
# source = "textfile"
# path = "/var/lib/node_exporter/textfile_collector/claude_usage.prom"
# window = "five_hour"
# relax_margin = 5
# max_age_seconds = 900
# on_signal_lost = "warn"
#
# [[governor.tier]]
# at = 50
# min_priority = 1              # P1 and above only
#
# [[governor.tier]]
# at = 70
# min_priority = 0              # P0 only
#
# [[governor.tier]]
# at = 80
# traits = ["support"]          # only support crew (and above) runs
#
# [[governor.tier]]
# at = 95
# action = "drain"              # full stop, work pushed first

# ---------------------------------------------------------------------------
# survival + lane — the two axes the throttle reads (see [roles.<name>] above).
#
#   lane      MULTI    what work this agent may take — monitoring, quipu, infra…
#   survival  SINGLE   which throttle band it lives in, and the bands are ORDERED:
#
#       first    shed FIRST
#       normal   the default, and what an undeclared fleet is
#       support  keeps the lights on — survives a `traits = ["support"]` tier
#       last     shed LAST; the agents that must still be standing to
#                coordinate a drain
#
# THE BANDS ARE NAMES, NOT NUMBERS, and that is the safety property. An integer
# rank requires everyone to remember which direction survives, and that direction
# is exactly what went wrong twice while this was designed: written from "low
# rank dies first" against a role map where administrator was 0, a throttle spins
# down the COORDINATOR first — the one agent that has to still be up to run the
# drain. `first` and `last` say which end they are; there is no sign to invert.
#
# NEVER DERIVED, ALWAYS DECLARED. Nothing seeds a band from a role name, so an
# administrator with no declared band is `normal` and sheds with everyone else.
# That is deliberate: implicit protection is how a fleet acquires agents no
# throttle can touch, and nobody can grep for a protection nobody wrote down.
# If your coordinator must outlive the fleet, SAY SO:
#
#   [roles.coordinator]
#   attachment = "rooted"
#   survival = "last"
#
#   [roles.oncall]
#   attachment = "reports-to"
#   survival = "support"
#   lane = ["monitoring", "infra"]
#
# Then put it on the card's role stack: roles = ["administrator", "coordinator"]
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# [session_budget] — A CEILING ON WHAT ONE SESSION MAY DO BEFORE IT REPORTS.
#
# NOT the same thing as [governor] above, and the difference is the reason this
# table exists. [governor] reads FLEET-WIDE Claude usage and asks "how much
# budget is left". [session_budget] asks "how far has THIS ONE agent gone".
# Eleven cheap agents and one agent doing eleven production deploys read
# identically on a usage gauge — and it was the second that ran for six hours
# unattended while the usage governor sat correctly below its first tier.
#
# The failure it prevents is structural, not careless: the haul advance is
# SELF-FEEDING. Closing a bead is what unblocks the next one, so completing work
# produces more work and there is no natural stopping point anywhere in the loop.
# Its one pre-existing ceiling — the context handoff — is a RECYCLE (shed
# context, the haul resumes), not a stop.
#
# THE DEFAULT IS OFF, BY OMITTING THE KEYS. Same rule as [governor]: declaring a
# limit is the enabling act, there is no separate `enabled` boolean to forget.
# A ceiling of 0 is REFUSED at parse rather than accepted — it would read as "no
# items allowed" and wedge every worker in the fleet from one typo.
#
#   max_hours    wall-clock for the current STRETCH of work. Not the harness
#                session: `/clear` starts a new session id, and the haul's own
#                handoff instructs a /clear and then resumes — so a session-keyed
#                budget would reset at exactly the moment the haul hands over,
#                silently, while appearing to work. A stretch is this agent's
#                events with no idle gap over 45 minutes.
#   max_items    haul items served in the stretch.
#   max_risk     PRODUCTION-CLASS actions — deploys and service restarts,
#                classified when the tool call is captured. Budget this TIGHTER
#                than the other two: three binary deploys and two service
#                restarts in one unattended stretch is a different animal from
#                three hours of editing. Dry runs (`--check`, `--syntax-check`),
#                ad-hoc log reads and scp/rsync FETCHES deliberately do not count.
#   on_signal_lost   "warn" (default) or "stop". warn = an unmeasurable session
#                runs UNBOUNDED and alarms every pass. It never fails INTO a
#                stop, for the same reason the usage governor never fails into a
#                drain: a probe bug must not halt the crew.
#
# WHEN IT TRIPS the haul stops serving, does not claim the next bead, and does
# not name it — naming it would hand over the exact thing being withheld. The
# agent is asked to push, write up the bead trail, and stop cleanly. It blocks
# EXACTLY ONCE per stretch: a Stop hook that blocks while the ceiling is over
# could never let the agent stop at all, which would be worse than no ceiling.
# ---------------------------------------------------------------------------

# [session_budget]
# max_hours = 4.0
# max_items = 4
# max_risk = 3
# on_signal_lost = "warn"
